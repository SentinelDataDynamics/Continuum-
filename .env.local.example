# Copy this file to .env.local and fill in real values.
# Nothing here is required for the page to run — every integration below
# degrades gracefully (forms explain what's missing) if a value is absent.
# That means you can deploy immediately and wire each one up when ready.

# --- Supabase (waitlist + pre-order + event storage) ---------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: Project Settings -> API -> service_role (SECRET — server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (Founders Pass pre-order charge) ----------------------------
# Settings -> API Keys & Webhooks in your Paystack dashboard.
# Use the pk_test_ key until you're ready to take real payments.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
